# Vinci Clips - Docker Compose environment
# Copy to .env in the project root: cp .env.example .env

# Required: Google Gemini API key (transcription + default analysis)
GEMINI_API_KEY=

# Optional: LLM provider configuration (see LLM_PROVIDERS.md)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=

# Frontend API URL (browser-accessible; use localhost when running Docker locally)
NEXT_PUBLIC_API_URL=http://localhost:8080
